# Copy this file to .env and adjust for your machine.
#   cp .env.example .env      (Mac/Linux)
#   copy .env.example .env    (Windows)
#
# .env is gitignored — never commit your local copy.

# ---- Model layer -----------------------------------------------------
# false = deterministic stub (works with no model installed, always safe)
# true  = call the real llama.cpp servers below
USE_REAL_MODEL=true

REASONING_MODEL_URL=http://localhost:8080/v1/chat/completions
CODE_MODEL_URL=http://localhost:8081/v1/chat/completions

REASONING_MODEL_NAME=Llama-3.2-3B-Instruct
CODE_MODEL_NAME=Qwen2.5-Coder-1.5B-Instruct

MODEL_TIMEOUT_SEC=120
MODEL_MAX_TOKENS=384
MODEL_TEMPERATURE=0.2

# ---- Knowledge base (MRPL grounding) ---------------------------------
USE_KNOWLEDGE_BASE=true
KB_TOP_K=2

# ---- Sandbox ---------------------------------------------------------
SANDBOX_TIMEOUT_SEC=5

# ---- API -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000


# Windows only, optional: set this if `tesseract --version` doesn't work
# in a fresh terminal even after adding it to PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe